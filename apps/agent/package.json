{
  "name": "remote-git",
  "version": "1.0.0",
  "description": "Remote Git agent for controlling Git repositories from your phone",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "remote-git": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "remote-git",
    "developer-tools"
  ],
  "author": "Adnan Pal",
  "license": "MIT",
  "dependencies": {
    "@remote-git/protocol": "file:../../packages/protocol",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}